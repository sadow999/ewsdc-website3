# Public site URL, used for canonical links, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://sadow999.github.io/ewsdc-website3

# Path prefix. Required for GitHub Pages project sites; leave empty for a
# custom domain or a <user>.github.io site.
NEXT_PUBLIC_BASE_PATH=/ewsdc-website3

# Contact form delivery endpoint (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty and the form falls back to opening the visitor's mail client.
NEXT_PUBLIC_FORM_ENDPOINT=
